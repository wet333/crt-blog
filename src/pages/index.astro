---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Link from '../components/Link.astro';
import AmberImg from '../components/AmberImg.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout>
    <Nav />
    <main id="contenido" class="flex flex-wrap gap-5">
        <h1 class="sr-only">Blog de wet333</h1>

        <!-- Debajo de lg los posts ocupan todo el ancho y el aside pasa abajo -->
        <section class="grow-6 shrink basis-full lg:basis-0" aria-label="Posts">
            {posts.map((post) => (
                <PostCard
                    title={post.data.title}
                    date={post.data.date}
                    category={post.data.category}
                    description={post.data.description}
                    slug={post.id}
                />
            ))}
        </section>

        <aside class="grow shrink basis-[250px] text-body md:text-meta md:grid md:grid-cols-2 md:gap-x-5 md:items-start lg:block">
            <section class="border-terminal p-3 md:p-4 mb-5">
                <h2 class="panel-title">Estado del servidor</h2>
                <AmberImg
                    class="mb-4"
                    src="https://images.unsplash.com/photo-1506399558188-acca6f8cbf41?q=80&w=800&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                    alt="Racks de servidores en un centro de datos"
                    width="800"
                    height="480"
                />
                <ul>
                    <li>Uptime: 4503 días</li>
                    <li>Temp: 34°C</li>
                    <li>Cores: active</li>
                    <!-- Lo muestra y controla crt-effects.ts; sin JS no hay animaciones que pausar. -->
                    <li>
                        <button type="button" id="crt-motion-toggle" class="crt-toggle" aria-pressed="true" hidden>
                            Animaciones: <span aria-hidden="true" data-state>[ON]</span>
                        </button>
                    </li>
                </ul>
            </section>

            <!-- En telefonos repetiria la lista de posts que esta justo arriba -->
            <section class="border-terminal p-3 md:p-4 mb-5 hidden md:block">
                <h2 class="panel-title">Top Posts</h2>
                <ul class="list-none p-0 m-0 space-y-2">
                    {posts.map((post, i) => (
                        <li>
                            <Link href={`/blog/${post.id}`}>
                                {post.data.title}{i === 0 ? ' (último)' : ''}
                            </Link>
                        </li>
                    ))}
                </ul>
            </section>
        </aside>
    </main>

    <Footer />
</BaseLayout>

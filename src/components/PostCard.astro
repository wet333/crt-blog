---
import Link from './Link.astro';
import { commandForPath } from '../utils/terminal';

interface Props {
    title: string;
    date: Date;
    category: string;
    description: string;
    slug: string;
}

const { title, date, category, description, slug } = Astro.props;
const formattedDate = date.toISOString().split('T')[0];
const href = `/blog/${slug}`;
---

<article class="border-terminal p-3 md:p-4 mb-4">
    <h2 class="m-0 pb-3 border-b border-dotted border-amber-bright">
        <a href={href} data-ps-command={commandForPath(href)} class="no-underline hover:underline">{title}</a>
    </h2>
    <p class="text-meta text-amber-dim mt-1 mb-4">
        Fecha: <time datetime={formattedDate}>{formattedDate}</time> | Categoría: {category}
    </p>
    <p>{description}</p>
    <Link href={href}>LEER MÁS<span class="sr-only">: {title}</span></Link>
</article>

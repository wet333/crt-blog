---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
    src: string;
    alt: string;
}

const { class: className, loading = 'lazy', decoding = 'async', ...rest } = Astro.props;
---

<div class:list={["img-amber", className]}>
    <img class="w-full h-auto" loading={loading} decoding={decoding} {...rest} />
</div>

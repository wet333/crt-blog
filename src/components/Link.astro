---
import type { HTMLAttributes } from 'astro/types';
import { commandForPath } from '../utils/terminal';

interface Props extends HTMLAttributes<'a'> {
    href: string;
    target?: '_blank' | '_self' | '_parent' | '_top';
    // Comando que se agrega al historial del header. Por defecto se deriva del href.
    command?: string;
    // button: bloque en video inverso (CTA). menu: texto que se invierte al seleccionarlo.
    variant?: 'button' | 'menu';
    // 'page' = esta pagina, 'true' = la seccion a la que pertenece la pagina.
    current?: 'page' | 'true' | false;
}

const { href, target, class: className, command, variant = 'button', current = false, ...rest } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
const psCommand = command ?? (isExternal ? `wget ${href}` : commandForPath(href));
---

<a
    href={href}
    target={target}
    rel={target === '_blank' ? 'noopener noreferrer' : undefined}
    aria-current={current || undefined}
    data-ps-command={psCommand}
    class:list={[
        // El padding lateral reserva siempre el lugar del cursor ">": aparece dentro del
        // link sin mover el texto ni pisar lo que esta alrededor.
        "group relative inline-block px-[1.75ch] no-underline",
        variant === 'button' && "negative-color",
        variant === 'menu' && "text-amber-bright hover:negative-color focus-visible:negative-color [&[aria-current]]:negative-color",
        className,
    ]}
    {...rest}
>
    <span
        class="absolute left-[0.25ch] opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-visible:opacity-100 group-[[aria-current]]:opacity-100 motion-reduce:transition-none"
        aria-hidden="true"
    >&gt;</span><slot />
</a>
